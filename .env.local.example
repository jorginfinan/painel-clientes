# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# (Supabase > Project Settings > API Keys)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_public

# SECRETA — só no servidor (criar usuários, migração). NUNCA exponha no front.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role
